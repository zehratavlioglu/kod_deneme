# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets and environment overrides
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.mobileprovision
secrets.properties
firebase_app_id_file.json
google-services.json

# Android signing material (never commit, even in a private repository)
android/key.properties
android/**/*.jks
android/**/*.keystore

# Native/diagnostic output
*.hprof
*.dmp
*.trace
*.tombstone
/diagnostics/
/exported-logs/
